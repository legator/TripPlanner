{
  "name": "trip-planner",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "build:mobile": "npm run build && cap sync",
    "build:android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "build:android:bundle": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "verify:release": "node scripts/verify-release-bundle.mjs",
    "build:ios:sim": "npm run build && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination \"generic/platform=iOS Simulator\" clean build CODE_SIGNING_ALLOWED=NO"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@here/flexpolyline": "^0.1.0",
    "@upstash/redis": "^1.38.0",
    "date-fns": "^3.6.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0"
  }
}
